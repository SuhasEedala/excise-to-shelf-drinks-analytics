		lineageTag: 2bf7451a-bbce-4ecb-86b3-963d29ceda14

	measure 'Net Revenue per Pack' = DIVIDE ( [Net Revenue], [Packs] )
		formatString: \$#,0.00
		displayFolder: 4 Revenue & Profit
		lineageTag: 125862c8-1b12-44fb-8fc5-f4f848fe7ea1

	measure 'GP per Pack' = DIVIDE ( [Gross Profit], [Packs] )
		formatString: \$#,0.00
		displayFolder: 4 Revenue & Profit
		lineageTag: 109cf4ae-f434-42c6-b5f6-a8a23f343b84

	measure 'PVM Volume Effect' =
			VAR PacksCY = [Packs]
			VAR PacksPY = [Packs PY]
			VAR AvgPricePY = DIVIDE ( [Net Revenue PY], PacksPY )
			RETURN IF ( PacksPY > 0, ( PacksCY - PacksPY ) * AvgPricePY )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Price Volume Mix
		lineageTag: f6fef7b9-a37f-4a7f-9e37-1abe28cccb97

	measure 'PVM Price Effect' =
			IF ( [Packs PY] > 0,
			    SUMX ( VALUES ( DimProduct[SKU] ),
			        VAR c = [Packs]
			        VAR pCY = DIVIDE ( [Net Revenue], c )
			        VAR pPY = DIVIDE ( [Net Revenue PY], [Packs PY] )
			        RETURN IF ( c > 0 && [Packs PY] > 0, c * ( pCY - pPY ) )
			    )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Price Volume Mix
		lineageTag: d51b70db-c593-4847-adde-3c706eeed88a

	measure 'PVM Mix Effect' = IF ( [Packs PY] > 0, ( [Net Revenue] - [Net Revenue PY] ) - [PVM Volume Effect] - [PVM Price Effect] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Price Volume Mix
		lineageTag: e1fa87fe-c695-44f5-b3ce-23e444aeee93

	measure 'Net Revenue Change' = IF ( [Net Revenue PY] > 0, [Net Revenue] - [Net Revenue PY] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Price Volume Mix
		lineageTag: 9b63ef51-ffee-481d-b4e5-444ab4a4dcde

	measure 'Promo Packs' = SUM ( FactSales[PromoPacks] )
		formatString: #,0
		displayFolder: 6 Promotions
