	measure 'Promo Share of Volume' = DIVIDE ( [Promo Packs], [Packs] )
		formatString: 0.0%
		displayFolder: 6 Promotions
		lineageTag: 18af52a4-e099-447d-bf5c-8387c6c9da90

	measure 'Avg Promo Depth' = DIVIDE ( CALCULATE ( [Promo Discount] ), SUM ( FactSales[PromoGrossSales] ) )
		formatString: 0.0%
		displayFolder: 6 Promotions
		lineageTag: 80cf1ad5-a911-4554-bf18-fcbb5cef7634

	measure 'GP Rank' = IF ( [Gross Profit] <> 0, RANKX ( CALCULATETABLE ( VALUES ( DimProduct[Product] ), ALLSELECTED ( DimProduct ) ), CALCULATE ( [Gross Profit], ALLEXCEPT ( DimProduct, DimProduct[Product] ) ), , DESC ) )
		formatString: 0
		displayFolder: 7 Portfolio
		lineageTag: 7f5ca772-adbd-432d-9c61-c173edadf560

	measure 'Cumulative GP %' =
			VAR cur = [Gross Profit]
			VAR tbl = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( DimProduct[Product] ), ALLSELECTED ( DimProduct ) ), "@gp", CALCULATE ( [Gross Profit], ALLEXCEPT ( DimProduct, DimProduct[Product] ) ) )
			RETURN IF ( NOT ISBLANK ( cur ), DIVIDE ( SUMX ( FILTER ( tbl, [@gp] >= cur ), [@gp] ), SUMX ( tbl, [@gp] ) ) )
		formatString: 0.0%
		displayFolder: 7 Portfolio
		lineageTag: 91a70e0c-335d-413d-8e44-343ded06f125

	measure 'Pareto Class' =
			VAR c = [Cumulative GP %]
			RETURN IF ( ISBLANK ( c ), BLANK (), IF ( c <= 0.8, "A - Core", IF ( c <= 0.95, "B - Support", "C - Tail" ) ) )
		displayFolder: 7 Portfolio
		lineageTag: a501f442-0034-4c52-8e35-62348b3da7fd

	measure 'Avg Est Shelf Price' = DIVIDE ( SUMX ( FactSales, FactSales[EstShelfPrice] * FactSales[PacksQty] ), [Packs] )
		formatString: \$#,0.00
		displayFolder: 7 Portfolio
		lineageTag: d38efdea-6d23-40d5-9634-89fb41fd0e5c

	measure 'Latest Est Shelf Price' =
			VAR lastM = CALCULATE ( MAX ( FactSales[MonthStart] ), ALL ( DimDate ) )
			RETURN CALCULATE ( DIVIDE ( SUMX ( FactSales, FactSales[EstShelfPrice] * FactSales[PacksQty] ), SUM ( FactSales[PacksQty] ) ), FactSales[MonthStart] = lastM, ALL ( DimDate ) )
		formatString: \$#,0.00
		displayFolder: 7 Portfolio
		lineageTag: 15c8e07e-ebe3-4866-998f-ead23ed83221

	measure 'Price Point Headroom' =
			VAR pp = MAX ( DimProduct[PricePoint] )
			RETURN IF ( HASONEVALUE ( DimProduct[SKU] ) && pp > 0, pp - ( CEILING ( [Latest Est Shelf Price], 1 ) - 0.01 ) )
		formatString: \$#,0.00;(\$#,0.00);\$0.00
		displayFolder: 7 Portfolio
		lineageTag: 033dd0e6-61ff-4c6c-83ad-468bc9cc7dbf

	measure 'SKUs Over Price Point' = COUNTROWS ( FILTER ( VALUES ( DimProduct[SKU] ), CALCULATE ( MAX ( DimProduct[PricePoint] ) ) > 0 && [Price Point Headroom] < 0 ) )
		formatString: 0
		displayFolder: 7 Portfolio
		lineageTag: 95626b4d-ec27-4104-aa80-dc725600e006

	measure 'Active Outlets' = DISTINCTCOUNT ( FactSales[CustomerID] )
